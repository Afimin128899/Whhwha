# Telegram Bot Token (от @BotFather для бота управления)
BOT_TOKEN=your_telegram_bot_token

# Telegram ID администратора (кому разрешен доступ к панели и куда слать чеки)
ADMIN_ID=your_telegram_user_id

# Пул Telegram API_ID и API_HASH через запятую
API_IDS=your_telegram_api_id
API_HASHES=your_telegram_api_hash

# Путь к базе данных
DB_PATH=bot_database.sqlite3

# Папка для файлов сессий (.session)
SESSIONS_DIR=sessions
